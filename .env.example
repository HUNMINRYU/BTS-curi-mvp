# Planned manual S3 document-rebuild workflow only. Next.js and curi-rag.service
# do not read CURI_DOCUMENT_BUCKET at runtime.
CURI_DOCUMENT_BUCKET=
CURI_DOCUMENT_PREFIX=documents/
CURI_RAG_STAGING_DIR=
CURI_LIBERAL_ARTS_ZIP=
CURI_ARCHITECTURE_ZIP=
CURI_COMPUTER_ENGINEERING_ZIP=
CURI_ACCOUNTING_TAX_ZIP=

# EC2-local FAISS retrieval service. It reads local index artifacts; Bedrock
# clients inherit their region from the SDK default provider chain.
CURI_RAG_INDEX_PATH=
CURI_RAG_CHUNKS_PATH=
CURI_RAG_RETRIEVER_URL=
CURI_STUDENT_TEST_PASSWORD=
CURI_PROFESSOR_TEST_PASSWORD=
